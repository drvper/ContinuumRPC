// Resources for Continuum.exe (cRPC): application icon and version information.
#include "Resource.h"
#include <winver.h>

#define CRPC_VERSION_BIN 2,0,1,0
#define CRPC_VERSION_STR "2.0.1"

LANGUAGE 9, 1

IDI_DISCORDBRIDGE ICON "DiscordBridge.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CRPC_VERSION_BIN
 PRODUCTVERSION CRPC_VERSION_BIN
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Continuum Rich Presence (cRPC)"
            VALUE "FileVersion", CRPC_VERSION_STR
            VALUE "InternalName", "cRPC"
            VALUE "OriginalFilename", "Continuum.exe"
            VALUE "ProductName", "Continuum Rich Presence"
            VALUE "ProductVersion", CRPC_VERSION_STR
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
